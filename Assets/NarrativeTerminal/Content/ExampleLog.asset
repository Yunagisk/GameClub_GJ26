  terminalTitle: "\u9057\u8FF9\u7EC8\u7AEF"
  subtitle: "FOREST ARCHIVE // \u53EF\u8BFB\u53D6\u8BB0\u5F55"
  entries:
  - title: "\u6700\u540E\u4E00\u6B21\u7EF4\u62A4"
    timestamp: DAY 01 // 18:42
    body: "\u96FE\u6C14\u4ECE\u77FF\u4E95\u6DF1\u5904\u6F2B\u4E0A\u6765\u7684\u65F6\u5019\uFF0C\u5B88\u6797\u4EBA\u628A\u7EC8\u7AEF\u9501\u8FDB\u4E86\u77F3\u5C4B\u3002\n\n\u8BB0\u5F55\u91CC\u53EA\u6709\u4E00\u53E5\u8BDD\uFF1A\n\n<color=#E3B15F>\u201C\u522B\u8BA9\u706B\u79CD\u7184\u706D\u3002\u201D</color>\n\n\u4ED6\u7167\u505A\u4E86\u3002\u81F3\u5C11\u4ED6\u4EE5\u4E3A\u81EA\u5DF1\u7167\u505A\u4E86\u3002"
    accent: {r: 0.89, g: 0.69, b: 0.37, a: 1}
  - title: "\u4E24\u4E2A\u5B69\u5B50"
    timestamp: DAY 02 // 03:17
    body: "\u76D1\u63A7\u753B\u9762\u91CC\uFF0C\u4E00\u7EA2\u4E00\u84DD\u4E24\u4E2A\u5C0F\u5C0F\u7684\u8EAB\u5F71\u7A7F\u8FC7\u82D4\u85D3\u8D70\u5ECA\u3002\n\n\u4ED6\u4EEC\u6CA1\u6709\u63A8\u5F00\u77F3\u95E8\uFF0C\u95E8\u5374\u81EA\u5DF1\u5F00\u4E86\u3002\n\n\u7CFB\u7EDF\u8BB0\u5F55\u5230\u4E24\u6B21\u5FC3\u8DF3\uFF0C\u9891\u7387\u5B8C\u5168\u4E00\u81F4\u3002"
    accent: {r: 0.89, g: 0.69, b: 0.37, a: 1}
  - title: "\u7EC8\u7AEF\u79BB\u7EBF"
    timestamp: DAY 03 // 07:42
    body: "\u4FE1\u53F7\u5728\u7B2C\u4E03\u7801\u5934\u4E0A\u65B9\u4E2D\u65AD\u3002\n\n\u5982\u679C\u4F60\u8BFB\u5230\u8FD9\u6BB5\u6587\u5B57\uFF0C\u8BF4\u660E\u7EC8\u7AEF\u8FD8\u6D3B\u7740\u2014\u2014\u6216\u8005\uFF0C\u8BF4\u660E\u4F60\u6B63\u5728\u8BFB\u5B83\u5E0C\u671B\u4F60\u770B\u7684\u4E1C\u897F\u3002\n\n\u7EE7\u7EED\u5F80\u4E0B\u8D70\u3002\u522B\u56DE\u5934\u3002"
    accent: {r: 0.89, g: 0.69, b: 0.37, a: 1}
